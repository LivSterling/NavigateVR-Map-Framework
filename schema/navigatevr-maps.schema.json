{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/navigatevr-maps.schema.json",
  "title": "NavigateVR Map Definitions",
  "type": "object",
  "required": [
    "schemaVersion",
    "mapPack",
    "maps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mapPack": {
      "type": "string",
      "minLength": 1
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/map"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "formID": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^0[xX][0-9A-Fa-f]{1,8}$"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      ]
    },
    "form": {
      "type": "object",
      "required": [
        "plugin",
        "formID"
      ],
      "properties": {
        "plugin": {
          "type": "string",
          "minLength": 5,
          "pattern": "\\.(esm|esp|esl)$"
        },
        "formID": {
          "$ref": "#/$defs/formID"
        }
      },
      "additionalProperties": false
    },
    "matrix": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      }
    },
    "map": {
      "type": "object",
      "required": [
        "id",
        "worldspace",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "worldspace": {
          "$ref": "#/$defs/form"
        },
        "items": {
          "type": "object",
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "$ref": "#/$defs/form"
            },
            "right": {
              "$ref": "#/$defs/form"
            }
          },
          "additionalProperties": false
        },
        "ownership": {
          "type": "object",
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "item": {
              "$ref": "#/$defs/form"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "required": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "item"
                ]
              }
            }
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "priority": {
              "type": "integer",
              "default": 0
            },
            "useForInteriors": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "markers": {
          "type": "object",
          "properties": {
            "calibration": {
              "type": "object",
              "properties": {
                "left": {
                  "$ref": "#/$defs/matrix"
                },
                "right": {
                  "$ref": "#/$defs/matrix"
                }
              },
              "additionalProperties": true
            },
            "CalibrationLeft": {
              "$ref": "#/$defs/matrix"
            },
            "CalibrationRight": {
              "$ref": "#/$defs/matrix"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
